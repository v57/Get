{
  "build": { "scheme": "Get", "project": "Get.xcodeproj" },
  "appearances": ["light", "dark"],
  "watch": ["Get", "Sources"],
  "mac": { "window": [1440, 900] },
  "scenes": [
    {
      "id": "01-downloads",
      "arguments": ["--screenshot-demo", "--select", "ubuntu-26.04-desktop-amd64.iso"],
      "caption": "Torrents and links in one place"
    },
    {
      "id": "02-files",
      "arguments": ["--screenshot-demo", "--select", "Open Photo Archive 2026"],
      "caption": "Pick the files you want first"
    },
    {
      "id": "03-link",
      "arguments": ["--screenshot-demo", "--select", "Atkinson-Hyperlegible.zip"],
      "caption": "Fast, resumable downloads from any link"
    },
    {
      "id": "04-add-url",
      "arguments": ["--screenshot-demo", "--add-url"],
      "caption": "Paste a link, add a checksum"
    },
    {
      "id": "05-device-link",
      "arguments": ["--screenshot-demo", "--select", "Fedora-Workstation-Live-44.iso"],
      "caption": "Download on your other devices"
    },
    {
      "id": "06-device-done",
      "arguments": ["--screenshot-demo", "--select", "Fedora-Workstation-Live-44.iso", "--device", "completed"],
      "caption": "Checked where it lands"
    },
    {
      "id": "07-device-failed",
      "arguments": ["--screenshot-demo", "--select", "Fedora-Workstation-Live-44.iso", "--device", "failed"],
      "caption": "See what went wrong, and retry"
    },
    {
      "id": "09-error",
      "arguments": ["--screenshot-demo", "--error", "Magnet links aren't supported yet. Open the .torrent file instead."],
      "caption": "Tells you when a download can't start"
    }
  ]
}
