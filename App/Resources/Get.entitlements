<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The v57 vault (../Vault): the hosts the v57 apps share (the user's Hub devices among them), in the app group
	     container; a copy of the vault keys in the records group (no passwords, no device key: security audit M4), and
	     an SSH key of the app's own in its own group, which the user allows on each Mac (Vault ▸ Settings ▸ Remote).
	     For Download on…: a link fetched on another device. iCloud sync through CloudKit. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dev.v57</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<string>$(AppIdentifierPrefix)dev.v57.records</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.v57</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
