#!/bin/zsh
# The asset catalog compiler for release archives (ASSETCATALOG_EXEC, installed as a file named `actool`, since Xcode
# reads its version as com.apple.<file name>.version): actool, then smaller app icon fallbacks.
#
# For an Icon Composer icon (`AppIcon.icon`), actool also renders flattened pictures of it for systems before
# macOS 26 (256, 512 and twice 1024 pixels) and stores them lossless. The renderer dithers every pixel, so they
# hardly compress: 1.6 of the 1.7 MB Assets.car of a 1.6 KB icon. This re-encodes those renditions with CoreUI's
# own HEVC encoder (what actool uses for `lossy` images), keeping each one's header, metadata and key, and checks
# that CoreUI decodes the result to the same picture before keeping it. The Liquid Glass layers macOS 26 draws
# from are untouched. Every other catalog goes through as actool wrote it.
#
#   ACTOOL_ICON_QUALITY   HEVC quality, 0...1 (default 0.8: Hub's Assets.car 1682 KB -> 137 KB, 42.9 dB)
real_actool=$(xcrun -f actool)
$real_actool "$@" || exit $?

out= icon=
for (( i = 1; i <= $#; i++ )); do
  case ${argv[i]} in
    --compile) out=${argv[++i]} ;;
    --*) ;;
    *.icon|*.icon/) icon=1 ;;
  esac
done
[[ -n $icon && -f $out/Assets.car ]] || exit 0

# The tool is built once per copy of this script, beside it.
tool=${0:A}.bin
if [[ ! -x $tool || $tool -ot ${0:A} ]]; then
  src=$(mktemp -t car-slim).m
  sed -n '/^\/\/ car-slim source/,$p' ${0:A} | sed 1d > $src
  xcrun clang -O2 -fno-objc-arc -framework Foundation -framework CoreGraphics -lcompression -o $tool $src 2>&1 \
    || { echo "$out/Assets.car: warning: actool-icon-slim could not build its tool; the icon stays lossless"; exit 0; }
  rm -f $src
fi
$tool ${ACTOOL_ICON_QUALITY:-0.8} $out/Assets.car \
  || echo "$out/Assets.car: warning: actool-icon-slim failed; the icon stays lossless"
exit 0

// car-slim source
#import <CoreGraphics/CoreGraphics.h>
#import <Foundation/Foundation.h>
#import <compression.h>
#import <dlfcn.h>
#import <objc/message.h>

// CoreUI's rendition format (CSI): a 184-byte header, metadata TLVs, then the pixels. actool stores a flattened
// icon as an `MLEC` block (version 1, codec 4 = lzfse) of `KCBC` row chunks of premultiplied BGRA.
static uint32_t rd(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }

// Built without ARC: CoreUI's initializers may return another object than the one allocated.
#define SEND(type, ...) ((type)objc_msgSend)(__VA_ARGS__)

// The lzfse pixels of an actool icon rendition, or nil for any other kind (already re-encoded ones included).
static NSData *pixelsOf(NSData *csi, uint32_t *width, uint32_t *height) {
  const uint8_t *b = csi.bytes;
  if (csi.length < 184 || memcmp(b, "ISTC", 4) || rd(b + 24) != 'ARGB') return nil;
  uint32_t w = rd(b + 12), h = rd(b + 16), o = 184 + rd(b + 168);
  if (o + 16 > csi.length || memcmp(b + o, "MLEC", 4) || rd(b + o + 4) != 1 || rd(b + o + 8) != 4) return nil;
  NSMutableData *pixels = [NSMutableData dataWithCapacity:(size_t)w * h * 4];
  size_t i = o + 16;
  for (uint32_t chunk = 0, chunks = rd(b + o + 12); chunk < chunks; chunk++) {
    if (i + 20 > csi.length || memcmp(b + i, "KCBC", 4)) return nil;
    uint32_t rows = rd(b + i + 12), length = rd(b + i + 16);
    if (i + 20 + length > csi.length) return nil;
    size_t size = (size_t)rows * w * 4, start = pixels.length;
    pixels.length = start + size;
    if (compression_decode_buffer((uint8_t *)pixels.mutableBytes + start, size, b + i + 20, length, NULL,
                                  COMPRESSION_LZFSE) != size) return nil;
    i += 20 + length;
  }
  if (pixels.length != (size_t)w * h * 4) return nil;
  *width = w; *height = h;
  return pixels;
}

// The rendition with its pixels encoded by CoreUI as HEVC: the original header and metadata, the new payload.
static NSData *hevc(NSData *csi, NSData *pixels, uint32_t w, uint32_t h, double quality) {
  id bitmap = SEND(id (*)(id, SEL, unsigned, unsigned), [NSClassFromString(@"CSIBitmapWrapper") alloc],
                   sel_registerName("initWithPixelWidth:pixelHeight:"), w, h);
  CGContextRef context = SEND(CGContextRef (*)(id, SEL), bitmap, sel_registerName("bitmapContext"));
  if (!context) return nil;
  size_t rowBytes = CGBitmapContextGetBytesPerRow(context);
  uint8_t *data = CGBitmapContextGetData(context);
  for (uint32_t y = 0; y < h; y++) memcpy(data + y * rowBytes, (const uint8_t *)pixels.bytes + (size_t)y * w * 4, w * 4);
  SEND(void (*)(id, SEL, BOOL), bitmap, sel_registerName("setAllowsHevcCompression:"), YES);
  id generator = SEND(id (*)(id, SEL, CGSize, unsigned, short), [NSClassFromString(@"CSIGenerator") alloc],
                      sel_registerName("initWithCanvasSize:sliceCount:layout:"), CGSizeMake(w, h), 1, 12);
  SEND(void (*)(id, SEL, id), generator, sel_registerName("addBitmap:"), bitmap);
  SEND(void (*)(id, SEL, CGRect), generator, sel_registerName("addSliceRect:"), CGRectMake(0, 0, w, h));
  SEND(void (*)(id, SEL, id), generator, sel_registerName("setName:"), @"icon.png");
  SEND(void (*)(id, SEL, long), generator, sel_registerName("setCompressionType:"), 3);  // lossy
  // HEVC before the quality: the quality set first is lost, and CoreUI falls back to JPEG.
  SEND(void (*)(id, SEL, BOOL), generator, sel_registerName("setAllowsHevcCompression:"), YES);
  SEND(void (*)(id, SEL, double), generator, sel_registerName("setCompressionQuality:"), quality);
  NSData *made = SEND(id (*)(id, SEL, BOOL), generator, sel_registerName("CSIRepresentationWithCompression:"), YES);
  if (made.length < 184) return nil;
  const uint8_t *m = made.bytes;
  size_t payload = 184 + rd(m + 168), header = 184 + rd((const uint8_t *)csi.bytes + 168);
  if (payload + 16 > made.length || memcmp(m + payload, "MLEC", 4)) return nil;
  NSMutableData *out = [NSMutableData dataWithBytes:csi.bytes length:header];
  [out appendBytes:m + payload length:made.length - payload];
  uint32_t length = (uint32_t)(out.length - header);
  [out replaceBytesInRange:NSMakeRange(180, 4) withBytes:&length];
  return out;
}

// How close CoreUI's decoding of `csi` is to `pixels`, in dB over the premultiplied channels (0 if it fails).
static double psnr(NSData *csi, const uint16_t *tokens, uint32_t version, NSData *pixels, uint32_t w, uint32_t h) {
  id rendition = SEND(id (*)(id, SEL, id, const void *, uint32_t), [NSClassFromString(@"CUIThemeRendition") alloc],
                      sel_registerName("initWithCSIData:forKey:version:"), csi, tokens, version);
  CGImageRef image = rendition ? SEND(CGImageRef (*)(id, SEL), rendition, sel_registerName("unslicedImage")) : NULL;
  if (!image || CGImageGetWidth(image) != w || CGImageGetHeight(image) != h) return 0;
  NSMutableData *drawn = [NSMutableData dataWithLength:(size_t)w * h * 4];
  CGColorSpaceRef space = CGImageGetColorSpace(image) ?: CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
  CGContextRef context = CGBitmapContextCreate(drawn.mutableBytes, w, h, 8, w * 4, space,
                                               kCGBitmapByteOrder32Little | kCGImageAlphaPremultipliedFirst);
  if (!context) return 0;
  CGContextSetBlendMode(context, kCGBlendModeCopy);
  CGContextDrawImage(context, CGRectMake(0, 0, w, h), image);
  CGContextRelease(context);
  const uint8_t *a = pixels.bytes, *b = drawn.bytes;
  double sum = 0;
  for (size_t i = 0; i < drawn.length; i++) { double d = (double)a[i] - b[i]; sum += d * d; }
  return sum == 0 ? 99 : 10 * log10(255.0 * 255.0 / (sum / drawn.length));
}

int main(int argc, char **argv) {
  @autoreleasepool {
    if (argc != 3) { fprintf(stderr, "usage: car-slim QUALITY Assets.car\n"); return 2; }
    double quality = atof(argv[1]);
    NSString *path = @(argv[2]);
    if (!dlopen("/System/Library/PrivateFrameworks/CoreUI.framework/CoreUI", RTLD_NOW)
        || !dlopen("/System/Library/PrivateFrameworks/CoreThemeDefinition.framework/CoreThemeDefinition", RTLD_NOW)
        || !NSClassFromString(@"CSIGenerator") || !NSClassFromString(@"CUIMutableCommonAssetStorage")) {
      fprintf(stderr, "car-slim: CoreUI's asset storage is not available\n");
      return 1;
    }
    id storage = SEND(id (*)(id, SEL, id, BOOL), [NSClassFromString(@"CUIMutableCommonAssetStorage") alloc],
                      sel_registerName("initWithPath:forWriting:"), path, YES);
    if (!storage) { fprintf(stderr, "car-slim: cannot open %s\n", argv[2]); return 1; }
    const uint32_t *format = SEND(const uint32_t *(*)(id, SEL), storage, sel_registerName("keyFormat"));
    uint32_t version = SEND(uint32_t (*)(id, SEL), storage, sel_registerName("distilledInCoreUIVersion"));
    // The app icon's flattened pictures: element 85, part 220 ("Icon Image"). Keys are stored in the key
    // format's attribute order; the enumeration hands out (attribute, value) pairs ending in a zero.
    NSMutableArray<NSData *> *keys = [NSMutableArray array], *tokens = [NSMutableArray array],
                             *blobs = [NSMutableArray array];
    void (^collect)(const uint16_t *, NSData *) = ^(const uint16_t *pairs, NSData *csi) {
      uint16_t key[64] = {0}, element = 0, part = 0;
      size_t count = 0;
      for (const uint16_t *p = pairs; p[0] && count < 32; p += 2, count++) {
        if (p[0] == 1) element = p[1];
        if (p[0] == 2) part = p[1];
        for (uint32_t k = 0; k < format[2] && k < 64; k++) if (format[3 + k] == p[0]) key[k] = p[1];
      }
      if (element != 85 || part != 220) return;
      [keys addObject:[NSData dataWithBytes:key length:format[2] * 2]];
      [tokens addObject:[NSData dataWithBytes:pairs length:(count * 2 + 2) * 2]];
      [blobs addObject:csi];
    };
    SEND(void (*)(id, SEL, id), storage, sel_registerName("enumerateKeysAndObjectsUsingBlock:"), collect);
    size_t before = 0, after = 0, changed = 0;
    for (NSUInteger n = 0; n < keys.count; n++) {
      NSData *old = blobs[n], *pixels, *new = nil;
      uint32_t w = 0, h = 0;
      before += old.length;
      if ((pixels = pixelsOf(old, &w, &h)) && (new = hevc(old, pixels, w, h, quality)) && new.length < old.length
          && psnr(new, tokens[n].bytes, version, pixels, w, h) >= 35) {
        if (!SEND(BOOL (*)(id, SEL, id, id), storage, sel_registerName("setAsset:forKey:"), new, keys[n])) {
          fprintf(stderr, "car-slim: could not replace a rendition\n");
          return 1;
        }
        after += new.length;
        changed++;
      } else {
        after += old.length;
      }
    }
    if (!changed) return 0;
    if (!SEND(BOOL (*)(id, SEL, BOOL), storage, sel_registerName("writeToDiskAndCompact:"), YES)) {
      fprintf(stderr, "car-slim: could not write %s\n", argv[2]);
      return 1;
    }
    printf("%s: note: app icon fallbacks %zu KB -> %zu KB (%zu renditions, HEVC %.2f)\n", argv[2], before / 1000,
           after / 1000, changed, quality);
  }
  return 0;
}
